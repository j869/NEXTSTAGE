<%- include('../partials/header', {userInfo: userInfo}) %>


    <h1>Tasks Dashboard</h1>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Description</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <% tasks.forEach(function(task) { %>
                <tr>
                    <td><%= task.id %></td>
                    <td><%= task.title %></td>
                    <td><%= task.description %></td>
                    <td><%= task.status %></td>
                </tr>
            <% }); %>
        </tbody>
    </table>



<%- include('../partials/footer') %>