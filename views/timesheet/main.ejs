function prevMonth() {
  month--;
  if (month < 0) {
    month = 11;
    year--;
  }
   localStorage.setItem("selectedMonth", month);
   localStorage.setItem("selectedYear", year);
  initCalendar();

}

function nextMonth() {
  month++;
  if (month > 11) {
    month = 0;
    year++;

  }
   localStorage.setItem("selectedMonth", month);
   localStorage.setItem("selectedYear", year);
  initCalendar();
}

prev.addEventListener("click", prevMonth);
next.addEventListener("click", nextMonth);

