        if (isMarkingEnabled) {
          btn.textContent = 'Unmark Timesheet';
          btn.classList.remove('btn-primary');
          btn.classList.add('btn-secondary');
          updateSelectedTimesheetInput();
              updateSelectedCount();
              toggleFormVisibility();
          
        } else {
          btn.textContent = 'Mark Timesheet';
          btn.classList.remove('btn-secondary');
          btn.classList.add('btn-primary');
          clearSelections();
          
          
        }
        toggleFormVisibility();
      }

      // Function to clear selections
      function clearSelections() {
        selectedTimesheetIds = [];
        document.querySelectorAll(".day.selected").forEach(day => day.classList.remove("selected"));
        updateSelectedTimesheetInput();
        updateSelectedCount();
      }

      function updateSelectedTimesheetInput() {
        const selectedTimesheetInput = document.querySelector("#selectedTimesheetIds");
        selectedTimesheetInput.value = selectedTimesheetIds.join(",");
      }

      function updateSelectedCount() {
        const selectedCount = document.querySelector("#selectedCount");
        selectedCount.style.display = isMarkingEnabled && selectedTimesheetIds.length > 0 ? "block" : "none";

        selectedCount.innerHTML = `<i class="fas fa-check-circle "></i> ${selectedTimesheetIds.length}`;
