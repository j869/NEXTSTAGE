        function handleVarianceTypeChange() {
        const selectedVarianceType = document.getElementById('variance_type').value;
        const customVarianceInputs = document.getElementById('customVarianceInputs');
        const flexiMixInput = document.getElementById('flexiMixInput');
        const tilMixInput = document.getElementById('tilMixInput');
        const overtimeMixInput = document.getElementById('overtimeMixInput');
        const variance = parseFloat(document.getElementById('variance').value);

        if (selectedVarianceType === 'mixed') {
            customVarianceInputs.style.display = 'flex';
            flexiMixInput.setAttribute('required', true);
            tilMixInput.setAttribute('required', true);
            overtimeMixInput.setAttribute('required', true);

            if (variance < 0) {
                flexiMixInput.setAttribute('min', variance);
                flexiMixInput.setAttribute('max', 0);
                tilMixInput.setAttribute('min', variance);
                tilMixInput.setAttribute('max', 0);
                overtimeMixInput.setAttribute('min', variance);
                overtimeMixInput.setAttribute('max', 0);
            } else {
                flexiMixInput.setAttribute('min', 0);
                flexiMixInput.setAttribute('max', variance);
                tilMixInput.setAttribute('min', 0);
                tilMixInput.setAttribute('max', variance);
                overtimeMixInput.setAttribute('min', 0);
                overtimeMixInput.setAttribute('max', variance);
            }
        } else {
            customVarianceInputs.style.display = 'none';
            flexiMixInput.removeAttribute('required');
            tilMixInput.removeAttribute('required');
            overtimeMixInput.removeAttribute('required');
        }
    }


