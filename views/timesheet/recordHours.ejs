<script>
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('locationSearch');
        const dropdownItems = document.querySelectorAll('.dropdown-item');

        searchInput.addEventListener('keyup', function () {
            const searchText = searchInput.value.toLowerCase();

            dropdownItems.forEach(item => {
                const text = item.textContent.toLowerCase();
                const isMatch = text.includes(searchText);
                // item.style.display = isMatch ? 'block' : 'none';
                item.parentElement.style.display =  isMatch ? 'block' : 'none';
            });
        });

        dropdownItems.forEach(item => {
            item.addEventListener('click', function (e) {
                e.preventDefault();
                const value = this.getAttribute('data-value');
                const text = this.textContent;
                document.getElementById('locationDropdown').textContent = text;
                document.getElementById('locationDropdown').setAttribute('data-selected-value', value);
                document.getElementById('location_id').value = value

            });
        });
    });

 

    function validateMixInputs() {
    const flexiMixInputElement = document.getElementById('flexiMixInput');
    const tilMixInputElement = document.getElementById('tilMixInput');
    const overtimeMixInputElement = document.getElementById('overtimeMixInput');
    const variance = parseFloat(document.getElementById('variance').value);

    const flexiError = document.getElementById('flexiError');
    const tilError = document.getElementById('tilError');
    const overtimeError = document.getElementById('overtimeError');

    let flexiMixInput = parseFloat(flexiMixInputElement.value) || 0;
    let tilMixInput = parseFloat(tilMixInputElement.value) || 0;
    let overtimeMixInput = parseFloat(overtimeMixInputElement.value) || 0;
    let isValid = true;

    // Clear previous errors
    flexiError.innerText = '';
    tilError.innerText = '';
    overtimeError.innerText = '';

    // Validate that no input is negative
    if (flexiMixInput < 0) {
        flexiError.innerText = 'Flexi Mix cannot be negative.';
        isValid = false;
    }
    if (tilMixInput < 0) {
        tilError.innerText = 'TIL Mix cannot be negative.';
        isValid = false;
    }
    if (overtimeMixInput < 0) {
        overtimeError.innerText = 'Overtime Mix cannot be negative.';
        isValid = false;
    }

    // Validate that the sum of all inputs equals the variance
    const totalMix = flexiMixInput + tilMixInput + overtimeMixInput;
    if (totalMix !== variance) {
        const errorMsg = `The sum of Flexi Mix, TIL Mix, and Overtime Mix must equal the variance of ${variance}.`;
        flexiError.innerText = errorMsg;
        tilError.innerText = errorMsg;
        overtimeError.innerText = errorMsg;
        isValid = false;
    }

    return isValid;
}


